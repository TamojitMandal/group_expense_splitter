# Server Configuration
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Database Connection
# SQLite out-of-the-box (zero configuration needed):
DATABASE_URL="file:./dev.db"
# Or PostgreSQL (e.g. docker compose up -d):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/splitwise?schema=public"

# Authentication & Security
JWT_SECRET=super_secret_jwt_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=7d

# Frontend Configuration (used in /client/.env)
VITE_API_URL=http://localhost:4000/api
